        "PA0",
        "PB2",
        "bộ điều khiển ngắt"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-cyan\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-cyan\">⚡ Phần cứng chuyên dụng: EXTI Pins</span>\n            <span class=\"badge badge-info\">Hardware Lines</span>\n          </div>\n          <svg class=\"circuit-svg\" viewBox=\"0 0 500 170\" style=\"background:#020617; border-radius:10px; border:1px solid rgba(56,189,248,0.25); margin-bottom:10px;\">\n            <!-- Golden PCB traces -->\n            <path d=\"M 40 45 L 140 45 L 160 65 L 190 65\" stroke=\"#38BDF8\" stroke-width=\"2.5\" fill=\"none\"/>\n            <path d=\"M 40 85 L 190 85\" stroke=\"#10B981\" stroke-width=\"2\" fill=\"none\"/>\n            <path d=\"M 40 125 L 140 125 L 160 105 L 190 105\" stroke=\"#F59E0B\" stroke-width=\"2\" fill=\"none\"/>\n            <!-- Pin labels -->\n            <rect x=\"25\" y=\"35\" width=\"80\" height=\"20\" rx=\"4\" fill=\"#0C4A6E\" stroke=\"#38BDF8\"/>\n            <text x=\"65\" y=\"49\" fill=\"#E0F2FE\" font-size=\"9.5\" font-weight=\"bold\" text-anchor=\"middle\">PA0 (EXTI0)</text>\n            <rect x=\"25\" y=\"75\" width=\"80\" height=\"20\" rx=\"4\" fill=\"#064E3B\" stroke=\"#10B981\"/>\n            <text x=\"65\" y=\"89\" fill=\"#D1FAE5\" font-size=\"9.5\" font-weight=\"bold\" text-anchor=\"middle\">PB2 (INT1)</text>\n            <rect x=\"25\" y=\"115\" width=\"80\" height=\"20\" rx=\"4\" fill=\"#78350F\" stroke=\"#F59E0B\"/>\n            <text x=\"65\" y=\"129\" fill=\"#FEF3C7\" font-size=\"9.5\" font-weight=\"bold\" text-anchor=\"middle\">NMI (Khẩn)</text>\n            <!-- Microcontroller IC -->\n            <rect x=\"190\" y=\"25\" width=\"130\" height=\"120\" rx=\"8\" fill=\"#0F172A\" stroke=\"#94A3B8\" stroke-width=\"2\"/>\n            <!-- IC Pins on top and bottom -->\n            <circle cx=\"210\" cy=\"38\" r=\"4\" fill=\"#F59E0B\"/>\n            <text x=\"255\" y=\"65\" fill=\"#FFFFFF\" font-size=\"12\" font-weight=\"800\" text-anchor=\"middle\">ARM Cortex-M</text>\n            <text x=\"255\" y=\"85\" fill=\"#38BDF8\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">STM32 / AVR</text>\n            <rect x=\"215\" y=\"98\" width=\"80\" height=\"22\" rx=\"4\" fill=\"#1E293B\" stroke=\"#38BDF8\"/>\n            <text x=\"255\" y=\"113\" fill=\"#7DD3FC\" font-size=\"9\" text-anchor=\"middle\">NVIC Controller</text>\n            <!-- Arrow to CPU Core -->\n            <path d=\"M 320 85 L 370 85\" stroke=\"#38BDF8\" stroke-width=\"3\" fill=\"none\" marker-end=\"url(#arrow)\"/>\n            <rect x=\"370\" y=\"55\" width=\"105\" height=\"60\" rx=\"6\" fill=\"#1E1B4B\" stroke=\"#818CF8\" stroke-width=\"2\"/>\n            <text x=\"422\" y=\"82\" fill=\"#FFFFFF\" font-size=\"11\" font-weight=\"bold\" text-anchor=\"middle\">CPU CORE</text>\n            <text x=\"422\" y=\"98\" fill=\"#34D399\" font-size=\"9\" text-anchor=\"middle\">⚡ Tức thì 0 ns!</text>\n          </svg>\n          <div style=\"font-size:12px; color:#94A3B8;\">\n            Đường dây phần cứng độc lập đưa tín hiệu thẳng vào thanh ghi ngắt mà không cần CPU phải quét (scan) thủ công.\n          </div>\n        </div>\n        "
