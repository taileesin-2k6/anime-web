      "content_html": "\n        <div class=\"glass-card card-glow-amber\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-amber\">📈 Dạng sóng tín hiệu trên Oscilloscope</span>\n            <span class=\"badge badge-warn\">Edge Triggering</span>\n          </div>\n          <svg class=\"circuit-svg\" viewBox=\"0 0 500 160\" style=\"background:#050B14; border-radius:10px; border:1px solid #1E293B; margin-bottom:8px;\">\n            <!-- Grid lines -->\n            <line x1=\"50\" y1=\"20\" x2=\"50\" y2=\"140\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"150\" y1=\"20\" x2=\"150\" y2=\"140\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"250\" y1=\"20\" x2=\"250\" y2=\"140\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"350\" y1=\"20\" x2=\"350\" y2=\"140\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"450\" y1=\"20\" x2=\"450\" y2=\"140\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"20\" y1=\"40\" x2=\"480\" y2=\"40\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"20\" y1=\"90\" x2=\"480\" y2=\"90\" stroke=\"#1E293B\" stroke-dasharray=\"3,3\"/>\n            <line x1=\"20\" y1=\"130\" x2=\"480\" y2=\"130\" stroke=\"#334155\"/>\n            <!-- Voltage levels -->\n            <text x=\"35\" y=\"44\" fill=\"#38BDF8\" font-size=\"9\" text-anchor=\"end\">3.3V</text>\n            <text x=\"35\" y=\"133\" fill=\"#64748B\" font-size=\"9\" text-anchor=\"end\">0.0V</text>\n            <!-- Rising edge waveform -->\n            <path d=\"M 50 130 L 190 130 L 205 40 L 450 40\" stroke=\"#38BDF8\" stroke-width=\"3.5\" fill=\"none\"/>\n            <!-- Trigger cursor line -->\n            <line x1=\"205\" y1=\"15\" x2=\"205\" y2=\"145\" stroke=\"#F59E0B\" stroke-width=\"2\" stroke-dasharray=\"4,3\"/>\n            <!-- Callout badge -->\n            <rect x=\"215\" y=\"60\" width=\"150\" height=\"36\" rx=\"6\" fill=\"#78350F\" stroke=\"#F59E0B\" stroke-width=\"1.5\"/>\n            <text x=\"290\" y=\"76\" fill=\"#FEF3C7\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">RISING EDGE DETECT</text>\n            <text x=\"290\" y=\"89\" fill=\"#FCD34D\" font-size=\"8.5\" text-anchor=\"middle\">Chốt cờ ngắt trong 15 ns</text>\n          </svg>\n          <div style=\"display:flex; justify-content:space-between; font-size:11.5px; color:#94A3B8;\">\n            <span>🟢 Sườn lên (Rising Edge: Low $\to$ High)</span>\n            <span>🔴 Sườn xuống (Falling Edge: High $\to$ Low)</span>\n          </div>\n        </div>\n        "
