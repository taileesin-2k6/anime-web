        "ngăn xếp Stack",
        "bảo toàn dữ liệu"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-cyan\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-cyan\">💾 Quá trình tự động cất ngữ cảnh (Stacking)</span>\n            <span class=\"badge badge-info\">12 Clock Cycles</span>\n          </div>\n          <svg class=\"circuit-svg\" viewBox=\"0 0 500 170\" style=\"background:#020617; border-radius:10px; border:1px solid #1E293B; margin-bottom:8px;\">\n            <!-- CPU Register File -->\n            <rect x=\"30\" y=\"25\" width=\"130\" height=\"120\" rx=\"6\" fill=\"#0F172A\" stroke=\"#38BDF8\" stroke-width=\"1.5\"/>\n            <text x=\"95\" y=\"45\" fill=\"#38BDF8\" font-size=\"11\" font-weight=\"bold\" text-anchor=\"middle\">CPU REGISTERS</text>\n            <text x=\"95\" y=\"65\" fill=\"#94A3B8\" font-size=\"9\" text-anchor=\"middle\">xPSR, PC, LR</text>\n            <text x=\"95\" y=\"82\" fill=\"#94A3B8\" font-size=\"9\" text-anchor=\"middle\">R12, R3, R2, R1, R0</text>\n            <text x=\"95\" y=\"112\" fill=\"#FBBF24\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">Đang tính dở...</text>\n            <!-- Push Arrow -->\n            <path d=\"M 160 85 L 240 85\" stroke=\"#F59E0B\" stroke-width=\"3\" stroke-dasharray=\"4,2\"/>\n            <text x=\"200\" y=\"75\" fill=\"#F59E0B\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">PUSH</text>\n            <!-- Stack Frame in RAM -->\n            <g transform=\"translate(250, 15)\">\n              <rect x=\"0\" y=\"0\" width=\"210\" height=\"140\" rx=\"6\" fill=\"#030712\" stroke=\"#475569\" stroke-width=\"1.5\"/>\n              <text x=\"105\" y=\"18\" fill=\"#F8FAFC\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">STACK MEMORY (RAM)</text>\n              <rect x=\"15\" y=\"26\" width=\"180\" height=\"13\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n              <text x=\"105\" y=\"36\" fill=\"#7DD3FC\" font-size=\"8\" text-anchor=\"middle\">xPSR (Thanh ghi trạng thái)</text>\n              <rect x=\"15\" y=\"41\" width=\"180\" height=\"13\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n              <text x=\"105\" y=\"51\" fill=\"#FCA5A5\" font-size=\"8\" font-weight=\"bold\" text-anchor=\"middle\">PC (Return Address vị trí tạm dừng)</text>\n              <rect x=\"15\" y=\"56\" width=\"180\" height=\"13\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n              <text x=\"105\" y=\"66\" fill=\"#FDE68A\" font-size=\"8\" text-anchor=\"middle\">LR (Link Register: EXC_RETURN)</text>\n              <rect x=\"15\" y=\"71\" width=\"180\" height=\"13\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n              <text x=\"105\" y=\"81\" fill=\"#CBD5E1\" font-size=\"8\" text-anchor=\"middle\">R12, R3, R2, R1, R0</text>\n              <rect x=\"15\" y=\"86\" width=\"180\" height=\"42\" fill=\"#064E3B\" stroke=\"#10B981\"/>\n              <text x=\"105\" y=\"103\" fill=\"#A7F3D0\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">✓ BẢO TOÀN DỮ LIỆU</text>\n              <text x=\"105\" y=\"118\" fill=\"#6EE7B7\" font-size=\"8\" text-anchor=\"middle\">Xong việc thì Pop Stack trở về</text>\n            </g>\n          </svg>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "BỘ NHỚ · BẢNG TỌA ĐỘ VÀNG",
      "title": "BẢNG VECTOR NGẮT (INTERRUPT VECTOR TABLE)",
      "voice_text": "Làm sao CPU biết phải chạy đoạn mã nào khi chân PA0 có ngắt? Nó nhìn vào Bảng Vector Ngắt đặt tại địa chỉ đầu tiên của bộ nhớ Flash. Bảng này thực chất là một danh sách các con trỏ hàm. Ứng với ngắt EXTI0, CPU đọc địa chỉ ghi tại ô nhớ tương ứng và nạp thẳng vào thanh ghi PC để bắt đầu thực thi hàm phục vụ ngắt ISR!",
      "subtitle": "Bảng Vector Ngắt đặt tại 0x0000_0000 chứa địa chỉ các hàm ISR để nạp thẳng vào con trỏ lệnh PC!",
      "highlight_words": [
        "Bảng Vector Ngắt",
        "0x0000_0000",
        "địa chỉ các hàm ISR",
        "con trỏ lệnh PC"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-green\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-green\">📋 Bảng Vector Ngắt tại Flash ROM (IVT)</span>\n            <span class=\"badge badge-success\">Function Pointers</span>\n          </div>\n          <div class=\"mono-code\" style=\"font-size:11.5px; line-height:1.55;\">\n            <span class=\"hl-purple\">0x0000_0000</span> : <span class=\"hl-cyan\">0x2000_5000</span> (Initial Main Stack Pointer)<br>\n            <span class=\"hl-purple\">0x0000_0004</span> : <span class=\"hl-green\">&Reset_Handler</span> (Khởi động hệ thống)<br>\n            <span class=\"hl-purple\">0x0000_0008</span> : <span class=\"hl-amber\">&NMI_Handler</span> (Ngắt khẩn cấp tối thượng)<br>\n            <span class=\"hl-purple\">0x0000_000C</span> : <span class=\"hl-rose\">&HardFault_Handler</span> (Lỗi kẹt phần cứng)<br>\n            ............................................................<br>\n            <span class=\"hl-purple\">0x0000_0058</span> : <span class=\"hl-cyan\">&EXTI0_IRQHandler</span> <span style=\"color:#F59E0B;\"><b>➜ Nhảy vào đây!</b></span>\n          </div>\n          <div style=\"margin-top:10px; font-size:12px; color:#94A3B8;\">\n            CPU đọc ô nhớ 32-bit tại <code>0x0000_0058</code>, nạp vào thanh ghi PC và bắt đầu chạy hàm C của bạn mà không cần tra cứu rườm rà.\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "XUNG ĐỘT · ĐỘ ƯU TIÊN",
      "title": "NGẮT LỒNG NHAU (INTERRUPT NESTING)",
      "voice_text": "Điều gì xảy ra nếu CPU đang bận nhận dữ liệu cổng nối tiếp UART mà một sự cố va chạm khẩn cấp ập tới? Nhờ cơ chế Ngắt lồng nhau (Nesting), NVIC sẽ so sánh độ ưu tiên. Tín hiệu va chạm có mức ưu tiên cao hơn sẽ ngắt ngang hàm UART đang chạy, xử lý xong tình huống khẩn cấp rồi mới quay trở lại cho UART tiếp tục công việc!",
      "subtitle": "Ngắt lồng nhau (Nesting): Ngắt độ ưu tiên cao (Va chạm) được phép cắt ngang ngắt thấp hơn (UART)!",
      "highlight_words": [
        "Ngắt lồng nhau",
        "Nesting",
        "độ ưu tiên cao",
        "cắt ngang ngắt thấp"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-amber\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-amber\">⚖️ Cơ chế ngắt lồng nhau (Preemption)</span>\n            <span class=\"badge badge-warn\">Priority Nesting</span>\n          </div>\n          <svg class=\"circuit-svg\" viewBox=\"0 0 500 150\" style=\"background:#090B14; border-radius:10px; border:1px solid #1E293B; margin-bottom:8px;\">\n            <!-- Main thread timeline -->\n            <rect x=\"30\" y=\"110\" width=\"120\" height=\"25\" rx=\"4\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n            <text x=\"90\" y=\"126\" fill=\"#E2E8F0\" font-size=\"9.5\" text-anchor=\"middle\">Main while(1)</text>\n            <rect x=\"370\" y=\"110\" width=\"100\" height=\"25\" rx=\"4\" fill=\"#1E293B\" stroke=\"#64748B\"/>\n            <text x=\"420\" y=\"126\" fill=\"#E2E8F0\" font-size=\"9.5\" text-anchor=\"middle\">Chạy tiếp...</text>\n            <!-- UART Interrupt Level 2 -->\n            <rect x=\"150\" y=\"65\" width=\"80\" height=\"25\" rx=\"4\" fill=\"#1E3A8A\" stroke=\"#38BDF8\"/>\n            <text x=\"190\" y=\"81\" fill=\"#BAE6FD\" font-size=\"9\" text-anchor=\"middle\">UART ISR (Pri 2)</text>\n            <rect x=\"310\" y=\"65\" width=\"60\" height=\"25\" rx=\"4\" fill=\"#1E3A8A\" stroke=\"#38BDF8\"/>\n            <text x=\"340\" y=\"81\" fill=\"#BAE6FD\" font-size=\"9\" text-anchor=\"middle\">UART tiếp</text>\n            <!-- Emergency Interrupt Level 0 -->\n            <rect x=\"230\" y=\"20\" width=\"80\" height=\"25\" rx=\"4\" fill=\"#7F1D1D\" stroke=\"#EF4444\" stroke-width=\"2\"/>\n            <text x=\"270\" y=\"36\" fill=\"#FECACA\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">VA CHẠM (Pri 0)</text>\n            <!-- Preempt arrows -->\n            <path d=\"M 150 110 L 150 90\" stroke=\"#38BDF8\" stroke-width=\"2\"/>\n            <path d=\"M 230 65 L 230 45\" stroke=\"#EF4444\" stroke-width=\"2\"/>\n            <path d=\"M 310 45 L 310 65\" stroke=\"#10B981\" stroke-width=\"2\"/>\n            <path d=\"M 370 90 L 370 110\" stroke=\"#10B981\" stroke-width=\"2\"/>\n          </svg>\n          <div style=\"font-size:12px; color:#FCD34D;\">\n            Càng nhỏ số độ ưu tiên thì quyền lực càng cao: <b>Priority 0</b> đè bẹp <b>Priority 2</b> ngay lập tức!\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "ĐẶC BIỆT · TỐI THƯỢNG",
      "title": "NGẮT NMI: LỆNH BÀI MIỄN TRỪ TỐI CAO",
      "voice_text": "Trong lập trình, có những lúc bạn tắt ngắt toàn cục bằng lệnh Disable Interrupt để bảo vệ vùng nhớ quan trọng. Nhưng có một loại ngắt mà bạn không bao giờ có thể che chắn được: đó là ngắt NMI! NMI dành riêng cho các sự cố sinh tử như mất nguồn điện đột ngột, thạch anh xung nhịp bị hỏng hoặc lỗi bộ nhớ nghiêm trọng!",
      "subtitle": "Ngắt NMI (Non-Maskable Interrupt): Không thể bị vô hiệu hóa bởi phần mềm, cứu mạng khi sập nguồn!",
      "highlight_words": [
        "NMI",
        "Non-Maskable Interrupt",
        "không thể che chắn",
        "cứu mạng khi sập nguồn"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-rose\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-rose\">🚨 Ngắt không thể che chắn (NMI)</span>\n            <span class=\"badge badge-danger\">Unstoppable</span>\n          </div>\n          <div class=\"diagram-box\" style=\"border-color:rgba(244,63,94,0.3); background:#0B050B;\">\n            <div style=\"display:flex; justify-content:space-around; align-items:center; margin-bottom:10px;\">\n              <div style=\"text-align:center; padding:8px; background:rgba(244,63,94,0.1); border-radius:8px;\">\n                <div style=\"font-size:18px;\">⚡</div>\n                <b style=\"font-size:11px; color:#FDA4AF;\">MẤT NGUỒN (Brown-out)</b><br>\n                <small style=\"color:#94A3B8;\">Kịp lưu dữ liệu vào Flash</small>\n              </div>\n              <div style=\"text-align:center; padding:8px; background:rgba(244,63,94,0.1); border-radius:8px;\">\n                <div style=\"font-size:18px;\">⏱️</div>\n                <b style=\"font-size:11px; color:#FDA4AF;\">HỎNG THẠCH ANH</b><br>\n                <small style=\"color:#94A3B8;\">Chuyển sang RC nội dự phòng</small>\n              </div>\n              <div style=\"text-align:center; padding:8px; background:rgba(244,63,94,0.1); border-radius:8px;\">\n                <div style=\"font-size:18px;\">🐕</div>\n                <b style=\"font-size:11px; color:#FDA4AF;\">WATCHDOG TIMEOUT</b><br>\n                <small style=\"color:#94A3B8;\">Hệ thống kẹt lệnh</small>\n              </div>\n            </div>\n            <div style=\"font-size:11.5px; color:#E2E8F0; border-top:1px dashed #334155; padding-top:8px;\">\n              Dù bạn có gọi lệnh tắt ngắt <code>__disable_irq()</code>, chân NMI vẫn xuyên thủng mọi hàng rào bảo vệ!\n            </div>\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "ĐO LƯỜNG · ĐỪNG ĐOÁN, HÃY TÍNH",
      "title": "ĐỘ TRỄ NGẮT THỰC TẾ LÀ BAO NHIÊU?",
      "voice_text": "Đừng đoán, hãy tính! Với một vi điều khiển STM32 chạy ở tần số bảy mươi hai megahertz, một chu kỳ xung nhịp chỉ mất mười ba phẩy tám mươi tám nano-giây. Thời gian phần cứng lưu Stack và nạp con trỏ hàm mất đúng mười hai chu kỳ, tức là khoảng hai trăm linh tám nano-giây! Nhanh hơn phương pháp Polling thủ công đến gần năm mươi nghìn lần!",
      "subtitle": "Đừng đoán, hãy tính: STM32 72 MHz -> 1 clock = 13.88 ns. Phản xạ ngắt chỉ mất 208 ns, nhanh hơn Polling 48.000 lần!",
      "highlight_words": [
        "Đừng đoán, hãy tính",
        "72 MHz",
        "208 ns",
        "nhanh hơn Polling 48.000 lần"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-amber\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-amber\">🔢 Đo lường chi tiết: Interrupt Latency</span>\n            <span class=\"badge badge-warn\">STM32F103 72MHz</span>\n          </div>\n          <div class=\"mono-code\">\n            <span class=\"hl-cyan\">1 chu kỳ Clock</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= 1 / 72,000,000 = <span class=\"hl-green\">13.88 ns</span><br>\n            <span class=\"hl-cyan\">Lưu Stack phần cứng</span> &nbsp;= 12 chu kỳ clock<br>\n            <span class=\"hl-cyan\">Pipeline Branch delay</span> = 3 chu kỳ clock<br>\n            ------------------------------------------------<br>\n            <span class=\"hl-amber\">Tổng độ trễ phản xạ (Latency)</span> = 15 × 13.88 ns<br>\n            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;= <span class=\"hl-green\">208.2 ns (0.2 µs)</span>\n          </div>\n          <div style=\"margin-top:10px; font-size:12.5px; color:#FCD34D;\">\n            ⚡ <b>So sánh Polling (10 ms):</b> 10,000,000 ns / 208 ns = <b>Nhanh hơn 48,000 lần!</b>\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "CẠM BẪY · NGUYÊN TẮC VÀNG",
      "title": "NHỮNG ĐIỀU CẤM KỴ TUYỆT ĐỐI TRONG ISR",
      "voice_text": "Sức mạnh của ngắt đi kèm với trách nhiệm lớn. Rất nhiều lập trình viên mắc sai lầm sơ đẳng khi đặt hàm delay hoặc in chuỗi printf bên trong hàm ngắt ISR. Điều này khiến toàn bộ vi điều khiển bị đóng băng, các ngắt khác bị phong tỏa và hệ thống sẽ sụp đổ ngay lập tức. Quy tắc vàng là: Hàm ngắt phải ngắn nhất có thể, chỉ bật cờ hiệu rồi thoát ra ngay!",
      "subtitle": "Cấm kỵ tuyệt đối: Không dùng delay() hay printf() trong ISR, nếu không toàn bộ vi xử lý sẽ đóng băng!",
      "highlight_words": [
        "Cấm kỵ tuyệt đối",
        "delay()",
        "printf()",
        "đóng băng"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-rose\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-rose\">🚫 3 Sai lầm phá hủy hệ thống trong ISR</span>\n            <span class=\"badge badge-danger\">Never Do This</span>\n          </div>\n          <div class=\"mono-code\" style=\"color:#FDA4AF; border-color:rgba(244,63,94,0.4);\">\n            <span class=\"hl-purple\">void</span> <span class=\"hl-cyan\">EXTI0_IRQHandler</span>(<span class=\"hl-purple\">void</span>) {<br>\n            &nbsp;&nbsp;<span style=\"color:#F43F5E; text-decoration:line-through;\">delay_ms(100);</span> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span style=\"color:#64748B;\">// ❌ Chết hệ thống!</span><br>\n            &nbsp;&nbsp;<span style=\"color:#F43F5E; text-decoration:line-through;\">printf(\"Got click!\");</span> &nbsp;<span style=\"color:#64748B;\">// ❌ Nghẽn UART!</span><br>\n            &nbsp;&nbsp;<span style=\"color:#F43F5E; text-decoration:line-through;\">read_slow_sensor();</span> &nbsp;<span style=\"color:#64748B;\">// ❌ Kẹt bus I2C!</span><br>\n            }\n          </div>\n          <div style=\"margin-top:10px; font-size:12px; color:#A7F3D0; background:rgba(16,185,129,0.1); padding:8px 12px; border-radius:8px; border:1px solid rgba(16,185,129,0.25);\">\n            💡 <b>Quy tắc vàng:</b> ISR chỉ làm 2 việc: Đọc dữ liệu nhanh vào RAM $\to$ Bật cờ Flag $\to$ Thoát ra trong dưới 1 micro-giây!\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "LẬP TRÌNH · BÍ QUYẾT CHUYÊN GIA",
      "title": "TỪ KHÓA VOLATILE VÀ CƠ CHẾ CỜ HIỆU",
      "voice_text": "Để truyền dữ liệu từ hàm ngắt ra chương trình chính an toàn, bạn phải khai báo biến cờ hiệu với từ khóa volatile. Từ khóa này cảnh báo trình biên dịch không được tối ưu hóa cất biến vào thanh ghi tạm, mà phải luôn đọc trực tiếp từ bộ nhớ RAM mỗi khi kiểm tra, tránh hiện tượng chương trình chính chạy sai vì dữ liệu bị bỏ sót!",
      "subtitle": "Khai báo biến chia sẻ với từ khóa volatile để bắt trình biên dịch luôn đọc từ RAM, tránh lỗi tối ưu hóa!",
      "highlight_words": [
        "volatile",
        "bắt trình biên dịch",
        "đọc từ RAM",
        "tránh lỗi tối ưu"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-cyan\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-cyan\">🛡️ Chuẩn viết mã an toàn (Flag Pattern)</span>\n            <span class=\"badge badge-info\">Production Ready</span>\n          </div>\n          <div class=\"mono-code\">\n            <span class=\"hl-purple\">volatile</span> <span class=\"hl-cyan\">uint8_t</span> flag_button = 0; <span style=\"color:#F59E0B;\">// 👈 Bắt buộc volatile!</span><br><br>\n            <span class=\"hl-purple\">void</span> <span class=\"hl-green\">EXTI0_IRQHandler</span>(<span class=\"hl-purple\">void</span>) {<br>\n            &nbsp;&nbsp;flag_button = 1; <span style=\"color:#64748B;\">// Bật cờ trong 50 ns</span><br>\n            }<br><br>\n            <span class=\"hl-purple\">while</span>(1) {<br>\n            &nbsp;&nbsp;<span class=\"hl-purple\">if</span> (flag_button) {<br>\n            &nbsp;&nbsp;&nbsp;&nbsp;flag_button = 0;<br>\n            &nbsp;&nbsp;&nbsp;&nbsp;<span class=\"hl-cyan\">process_slow_task();</span> <span style=\"color:#64748B;\">// Làm việc nặng ở đây!</span><br>\n            &nbsp;&nbsp;}<br>\n            }\n          </div>\n        </div>\n        "
    },
    {
      "brand": "VI XỬ LÝ & NHÚNG",
      "topic_tag": "THỰC CHIẾN · HỆ THỐNG AN TOÀN",
      "title": "HỆ THỐNG PHANH KHẨN CẤP ABS TRÊN Ô TÔ",
      "voice_text": "Trong đời sống thực, Interrupt chính là người hùng thầm lặng bảo vệ tính mạng con người. Trên xe hơi, cảm biến tốc độ bánh xe liên tục kích hoạt ngắt phần cứng lên bộ điều khiển ECU để điều khiển van phanh ABS nhấp nhả mười lăm lần mỗi giây khi phanh gấp. Còn khi xảy ra va chạm, ngắt mức cao nhất sẽ nổ bung túi khí trong mười mili-giây trước khi tài xế kịp va vào tay lái!",
      "subtitle": "Interrupt là người hùng cứu mạng: Điều khiển phanh ABS nhấp nhả 15 lần/s và bung túi khí trong 10 ms!",
      "highlight_words": [
        "cứu mạng",
        "phanh ABS",
        "15 lần/s",
        "bung túi khí trong 10 ms"
      ],
      "content_html": "\n        <div class=\"glass-card card-glow-green\">\n          <div class=\"card-header\">\n            <span class=\"card-title hl-green\">🚗 Hệ thống an toàn trên ô tô hiện đại</span>\n            <span class=\"badge badge-success\">Automotive ECU</span>\n          </div>\n          <svg class=\"circuit-svg\" viewBox=\"0 0 500 170\" style=\"background:#020E08; border-radius:10px; border:1px solid rgba(16,185,129,0.3); margin-bottom:8px;\">\n            <!-- Wheel Sensor -->\n            <rect x=\"20\" y=\"25\" width=\"100\" height=\"45\" rx=\"6\" fill=\"#134E4A\" stroke=\"#2DD4BF\"/>\n            <text x=\"70\" y=\"45\" fill=\"#CCFBF1\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">CẢM BIẾN BÁNH</text>\n            <text x=\"70\" y=\"60\" fill=\"#5EEAD4\" font-size=\"8.5\" text-anchor=\"middle\">Tần số xung cao</text>\n            <!-- Airbag Sensor -->\n            <rect x=\"20\" y=\"95\" width=\"100\" height=\"45\" rx=\"6\" fill=\"#7F1D1D\" stroke=\"#F87171\"/>\n            <text x=\"70\" y=\"115\" fill=\"#FEE2E2\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">CẢM BIẾN VA CHẠM</text>\n            <text x=\"70\" y=\"130\" fill=\"#FCA5A5\" font-size=\"8.5\" text-anchor=\"middle\">Gia tốc biến thiên</text>\n            <!-- Wires with signals -->\n            <path d=\"M 120 47 L 200 47\" stroke=\"#2DD4BF\" stroke-width=\"2.5\" stroke-dasharray=\"3,3\"/>\n            <text x=\"160\" y=\"40\" fill=\"#2DD4BF\" font-size=\"8\" text-anchor=\"middle\">EXTI Interrupt</text>\n            <path d=\"M 120 117 L 200 117\" stroke=\"#EF4444\" stroke-width=\"3\"/>\n            <text x=\"160\" y=\"110\" fill=\"#EF4444\" font-size=\"8\" font-weight=\"bold\" text-anchor=\"middle\">NMI / Priority 0</text>\n            <!-- Main Automotive ECU -->\n            <rect x=\"200\" y=\"30\" width=\"120\" height=\"110\" rx=\"8\" fill=\"#0F172A\" stroke=\"#38BDF8\" stroke-width=\"2\"/>\n            <text x=\"260\" y=\"60\" fill=\"#FFFFFF\" font-size=\"12\" font-weight=\"900\" text-anchor=\"middle\">ECU STM32</text>\n            <text x=\"260\" y=\"80\" fill=\"#38BDF8\" font-size=\"9\" text-anchor=\"middle\">NVIC Controller</text>\n            <rect x=\"215\" y=\"95\" width=\"90\" height=\"25\" rx=\"4\" fill=\"#064E3B\" stroke=\"#10B981\"/>\n            <text x=\"260\" y=\"111\" fill=\"#A7F3D0\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">XỬ LÝ < 100 µs</text>\n            <!-- Actuators on right -->\n            <rect x=\"360\" y=\"25\" width=\"115\" height=\"45\" rx=\"6\" fill=\"#1E3A8A\" stroke=\"#60A5FA\"/>\n            <text x=\"417\" y=\"45\" fill=\"#DBEAFE\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">VAN PHANH ABS</text>\n            <text x=\"417\" y=\"60\" fill=\"#93C5FD\" font-size=\"8.5\" text-anchor=\"middle\">Nhấp nhả 15 lần/giây</text>\n            <rect x=\"360\" y=\"95\" width=\"115\" height=\"45\" rx=\"6\" fill=\"#831843\" stroke=\"#F472B6\"/>\n            <text x=\"417\" y=\"115\" fill=\"#FCE7F3\" font-size=\"10\" font-weight=\"bold\" text-anchor=\"middle\">KÍCH NỔ TÚI KHÍ</text>\n            <text x=\"417\" y=\"130\" fill=\"#F9A8D4\" font-size=\"8.5\" text-anchor=\"middle\">Bung trong 10 ms!</text>\n            <path d=\"M 320 47 L 360 47\" stroke=\"#60A5FA\" stroke-width=\"2\"/>\n            <path d=\"M 320 117 L 360 117\" stroke=\"#F472B6\" stroke-width=\"3\"/>\n          </svg>\n        </div>\n        "
